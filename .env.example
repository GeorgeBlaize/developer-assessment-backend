# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database (Neon/Supabase/Railway Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CLIENT_URL=http://localhost:3000

# Google OAuth (GCP) - ID token verification, no redirect flow needed
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSLCommerz (sandbox)
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false
SSLCZ_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
SSLCZ_FAIL_URL=http://localhost:5000/api/v1/payments/fail
SSLCZ_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel
SSLCZ_IPN_URL=http://localhost:5000/api/v1/payments/ipn

# Seed admin
ADMIN_EMAIL=admin@codeassess.dev
ADMIN_PASSWORD=Admin@12345
