generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  COMPANY
  CANDIDATE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ProblemType {
  CODING
  MCQ
  WRITTEN
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

enum SubmissionStatus {
  PENDING
  AUTO_GRADED
  MANUALLY_GRADED
}

enum PlanName {
  FREE
  BASIC
  PRO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  EXPIRED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String?
  provider      AuthProvider @default(LOCAL)
  googleId      String?      @unique
  role          Role
  isActive      Boolean      @default(true)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  companyProfile   CompanyProfile?
  candidateProfile CandidateProfile?
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  gradedSubmissions Submission[]    @relation("GradedBy")

  @@index([role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Company & Candidate profiles
// ---------------------------------------------------------------------------

model CompanyProfile {
  id                  String              @id @default(uuid())
  userId              String              @unique
  companyName         String
  website             String?
  industry            String?
  planId              String?
  subscriptionStatus  SubscriptionStatus  @default(INACTIVE)
  subscriptionStartAt DateTime?
  subscriptionEndsAt  DateTime?
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan?         @relation(fields: [planId], references: [id])
  assessments  Assessment[]
  payments     Payment[]

  @@index([subscriptionStatus])
  @@map("company_profiles")
}

model CandidateProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  phone     String?
  resumeUrl String?
  skills    String[] @default([])
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations Invitation[]
  attempts    Attempt[]

  @@map("candidate_profiles")
}

// ---------------------------------------------------------------------------
// Subscription plans & payments (SSLCommerz)
// ---------------------------------------------------------------------------

model Plan {
  id                      String   @id @default(uuid())
  name                    PlanName @unique
  price                   Decimal  @db.Decimal(10, 2)
  currency                String   @default("BDT")
  durationDays            Int
  maxActiveAssessments    Int
  maxInvitesPerAssessment Int
  features                String[] @default([])
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  companies CompanyProfile[]
  payments  Payment[]

  @@map("plans")
}

model Payment {
  id               String        @id @default(uuid())
  companyId        String
  planId           String
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("BDT")
  status           PaymentStatus @default(PENDING)
  tranId           String        @unique
  gatewayResponse  Json?
  validatedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan           @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Assessments & problems
// ---------------------------------------------------------------------------

model Assessment {
  id              String           @id @default(uuid())
  companyId       String
  title           String
  description     String
  status          AssessmentStatus @default(DRAFT)
  durationMinutes Int
  passingScore    Int              @default(0)
  totalMarks      Int              @default(0)
  startWindow     DateTime?
  endWindow       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  problems    Problem[]
  invitations Invitation[]
  attempts    Attempt[]

  @@index([companyId])
  @@index([status])
  @@map("assessments")
}

model Problem {
  id                String      @id @default(uuid())
  assessmentId      String
  type              ProblemType
  title             String
  description       String
  marks             Int         @default(10)
  order             Int         @default(0)
  languageHint      String?
  starterCode       String?
  testCases         Json?
  correctAnswerText String?
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  assessment  Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options     McqOption[]
  submissions Submission[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
  @@map("problems")
}

model McqOption {
  id        String  @id @default(uuid())
  problemId String
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([problemId])
  @@map("mcq_options")
}

// ---------------------------------------------------------------------------
// Invitations, attempts & submissions
// ---------------------------------------------------------------------------

model Invitation {
  id           String           @id @default(uuid())
  assessmentId String
  candidateId  String
  email        String
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  invitedAt    DateTime         @default(now())
  expiresAt    DateTime
  deletedAt    DateTime?

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate  CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attempt    Attempt?

  @@unique([assessmentId, candidateId])
  @@index([assessmentId])
  @@index([status])
  @@map("invitations")
}

model Attempt {
  id           String        @id @default(uuid())
  invitationId String        @unique
  candidateId  String
  assessmentId String
  status       AttemptStatus @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  expiresAt    DateTime?
  totalScore   Int?
  isPassed     Boolean?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invitation Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  candidate  CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([candidateId])
  @@index([assessmentId])
  @@index([status])
  @@map("attempts")
}

model Submission {
  id               String           @id @default(uuid())
  attemptId        String
  problemId        String
  answerText       String?
  selectedOptionId String?
  isCorrect        Boolean?
  awardedMarks     Int?
  status           SubmissionStatus @default(PENDING)
  gradedById       String?
  gradedAt         DateTime?
  feedback         String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attempt        Attempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem        Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  selectedOption McqOption? @relation(fields: [selectedOptionId], references: [id])
  gradedBy       User?      @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([attemptId, problemId])
  @@index([attemptId])
  @@index([problemId])
  @@map("submissions")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
